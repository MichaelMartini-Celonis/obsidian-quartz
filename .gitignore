# Ignores for the ~/docs knowledge repository.

# macOS
.DS_Store

# Independent reference checkouts — cloned/pulled separately, only used as reference.
# (e.g. the Celonis Context Model documentation wiki)
reference/

# Source document libraries — large binaries, managed via the Inbox importer, not git.
# (versioned instead in the companion Git LFS repo, see scripts/package-data.py)
Literature/
Inbox/*
!Inbox/README.md

# YouTube video transcripts — fetched/generated via scripts/import-youtube.py.
Transcripts/

# Jupyter notebooks collected out of the library into their own top-level root.
notebooks/

# Database-system reference pages (dbdb.io mirror) — generated via scripts/dbdb-systems.py.
db_systems/

# Outbox — authored working drafts/artifacts; pushed to their own repos, not tracked here.
Outbox/

# Python tooling
scripts/.venv/
scripts/credentials.json
scripts/.token.json
scripts/.google-docs-manifest.json

# Import manifests + library backups (large / machine-local)
imports/

# Search engine index (rebuilt from the corpus)
search/*.duckdb
search/*.duckdb.wal
**/__pycache__/
